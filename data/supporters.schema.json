{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organisations supporting NFPs with AI",
  "type": "object",
  "required": [
    "meta",
    "supporters"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "last_updated"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "supporters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supporter"
      }
    }
  },
  "$defs": {
    "supporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organisation",
        "org_type",
        "based_in",
        "offering_category",
        "offering",
        "stage",
        "quote",
        "sources",
        "first_seen",
        "last_seen"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organisation": {
          "type": "string"
        },
        "org_type": {
          "type": "string",
          "enum": [
            "Technology company",
            "Software vendor",
            "Fundraising platform",
            "Consultancy",
            "NFP intermediary",
            "Corporate foundation",
            "Philanthropic foundation",
            "Social enterprise",
            "Other"
          ]
        },
        "based_in": {
          "type": "string"
        },
        "australian_presence": {
          "type": "string"
        },
        "offering_category": {
          "type": "string",
          "enum": [
            "fundraising",
            "case notes and frontline admin",
            "back office and ERP",
            "client-facing tools",
            "skills and capability building",
            "grantmaking",
            "funding and partnerships",
            "other"
          ]
        },
        "offering": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "available",
            "pilot",
            "planned",
            "discontinued"
          ]
        },
        "nfp_clients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "Publisher (date)"
              }
            }
          }
        },
        "first_seen": {
          "type": "string",
          "format": "date"
        },
        "last_seen": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
